mock_provider "aws" {
  alias           = "principal"
  override_during = plan
  mock_resource "aws_ec2_transit_gateway_vpc_attachment" { defaults = { id = "tgw-attach-00000000000000001" } }
}
mock_provider "aws" {
  alias           = "network"
  override_during = plan
  mock_resource "aws_customer_gateway" { defaults = { id = "cgw-00000000000000001" } }
  mock_resource "aws_vpn_connection" { defaults = { id = "vpn-00000000000000001", transit_gateway_attachment_id = "tgw-attach-00000000000000002", customer_gateway_configuration = "", tunnel1_preshared_key = "", tunnel2_preshared_key = "" } }
  mock_resource "aws_ec2_managed_prefix_list" { defaults = { id = "pl-00000000000000001" } }
}
variables {
  workload_plan_role_arn = "arn:aws:iam::${format("%012d", 0)}:role/fixture-workload-plan"
  network_plan_role_arn  = "arn:aws:iam::${format("%012d", 1)}:role/fixture-network-plan"
  aws_region             = "us-east-1"
  common_tags            = { Client = "fx", Project = "cf", Environment = "pdn", Owner = "fixture", CostCenter = "collection-centers" }
  collection_center      = { key = "cauca" }
  environment            = "pdn"
  network                = { environment = "pdn", account_id = format("%012d", 0), vpc_id = "vpc-00000000000000000", vpc_cidr_block = "10.82.0.0/16", transit_attachment_subnet_ids = ["subnet-00000000000000001", "subnet-00000000000000002", "subnet-00000000000000003"] }
  hub                    = { account_id = format("%012d", 1), region = "us-east-1", transit_gateway_id = "tgw-00000000000000000", customer_certificate_arn = "arn:aws:acm:us-east-1:${format("%012d", 1)}:certificate/00000000-0000-0000-0000-000000000000" }
}
run "cauca_connection" {
  command = plan
  variables { collection_center = { key = "cauca" } }
  assert {
    condition     = output.selected_center.key == "cauca" && output.selected_center.cidr_block == "10.41.0.0/16" && output.routing_references.vpn_connection_id == "vpn-00000000000000001" && output.routing_references.vpc_attachment_id == "tgw-attach-00000000000000001"
    error_message = "Only the selected departmental connection and its B07 references may be planned."
  }
}
run "huila_connection" {
  command = plan
  variables { collection_center = { key = "huila" } }
  assert {
    condition     = output.selected_center.key == "huila" && output.selected_center.cidr_block == "10.42.0.0/16" && output.routing_references.vpn_connection_id == "vpn-00000000000000001" && output.routing_references.vpc_attachment_id == "tgw-attach-00000000000000001"
    error_message = "Only the selected departmental connection and its B07 references may be planned."
  }
}
run "tolima_connection" {
  command = plan
  variables { collection_center = { key = "tolima" } }
  assert {
    condition     = output.selected_center.key == "tolima" && output.selected_center.cidr_block == "10.43.0.0/16" && output.routing_references.vpn_connection_id == "vpn-00000000000000001" && output.routing_references.vpc_attachment_id == "tgw-attach-00000000000000001"
    error_message = "Only the selected departmental connection and its B07 references may be planned."
  }
}
