output "selected_center" {
  description = "Validated single-center configuration for future D05 wiring; this is not a provisioned connection."
  value       = local.selected_center
}

output "routing_references" {
  description = "B07's public references for the selected connection; no routes are managed here."
  value       = { vpc_attachment_id = module.association.vpc_attachment_id, vpn_attachment_id = module.association.vpn_attachment_id, prefix_list_id = module.association.center_prefix_list_id, customer_gateway_id = module.association.customer_gateway_id, vpn_connection_id = module.association.vpn_connection_id }
}
